# ================================================================
#  AI Sales Intelligence Pipeline — Environment Variables
#  Copy this file, rename to .env, and fill in your keys.
#  NEVER commit .env to Git — it's already in .gitignore.
# ================================================================

# ──────────────────────────────────────────────────────────────
# 1. AI / LLM APIs  (for summarisation inside the pipeline)
#    At least one is recommended. Gemini is free-tier friendly.
# ──────────────────────────────────────────────────────────────

# OpenAI  →  https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini  →  https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ──────────────────────────────────────────────────────────────
# 2. LinkedIn Data  (choose one method)
# ──────────────────────────────────────────────────────────────

# Option A: ProxyCurl API  →  https://nubela.co/proxycurl
#   Paid service that gives full LinkedIn post access.
#   Free tier = 10 credits/month.
PROXYCURL_API_KEY=

# Option B: Direct LinkedIn credentials
#   Used for basic public page scraping only.
#   LinkedIn blocks most scrapers — ProxyCurl is more reliable.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ──────────────────────────────────────────────────────────────
# 3. Search APIs  (optional — Bing scraping works without these)
# ──────────────────────────────────────────────────────────────

# SerpAPI  →  https://serpapi.com/
#   Gives structured Google Search results (100 free searches/month).
SERPAPI_KEY=

# ──────────────────────────────────────────────────────────────
# 4. OCR — Tesseract path  (only needed for scanned PDFs)
#    Leave blank if Tesseract is in your PATH.
#    Windows download: https://github.com/UB-Mannheim/tesseract/wiki
# ──────────────────────────────────────────────────────────────

TESSERACT_CMD=
# Example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ──────────────────────────────────────────────────────────────
# 5. Pipeline tuning  (optional — safe to leave as defaults)
# ──────────────────────────────────────────────────────────────

# Chunk size in tokens  (default: 400)
CHUNK_SIZE_TOKENS=400

# Overlap between chunks in tokens  (default: 80)
CHUNK_OVERLAP_TOKENS=80

# Chunking strategy: auto | fixed_token | sentence | semantic | page_aware | hierarchical
CHUNKING_STRATEGY=auto

# OCR language code  (default: eng)  e.g. eng+fra for English+French
OCR_LANGUAGE=eng

# Number of top results from semantic search  (default: 5)
CHROMA_TOP_K=5

# Web scraper: seconds to wait between requests  (default: 2)
REQUEST_DELAY=2
